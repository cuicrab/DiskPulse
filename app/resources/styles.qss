/* ==========================================================================
   DiskPulse — Clean & Quiet 主题（浅色版）
   设计原则
     · 单一强调色 + 语义色，其余全部用中性灰
     · 不用装饰性边框，靠留白与字重分层
     · 所有标签显式声明 background: transparent，避免 Qt 填入默认底色
       （否则像 sectionHeader 这类只设 color 的 QLabel 会出现突兀的色块）
   配色系统
     画布   #F7F8FA      卡片 #FFFFFF      悬停 #F1F3F6
     描边   #E4E7EC      分隔 #EDEFF3
     主文本 #1C2024      次要 #5B6472      弱化 #8A93A2
     强调   #12A87B（主操作/选中/当前页）
     警示   #C77700      危险 #D6453B
     类别标签：淡底 + 同色系深字
   ========================================================================== */

/* ---------- 基础 ---------- */
QWidget {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
    color: #1C2024;
}

QMainWindow, #mainWindow {
    background-color: #F7F8FA;
}

#contentArea {
    background-color: #F7F8FA;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #E4E7EC;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---------- 侧边栏 ---------- */
#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E7EC;
}

#sidebarLogo {
    background: transparent;
    color: #1C2024;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 22px 20px;
    border-bottom: 1px solid #EDEFF3;
}

#navButton {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #5B6472;
    font-size: 14px;
    padding: 12px 18px;
    text-align: left;
}

#navButton:hover {
    background-color: #F1F3F6;
    color: #1C2024;
}

#navButton:checked {
    background-color: #EAF7F2;
    border-left: 2px solid #12A87B;
    color: #0E8A65;
    font-weight: 600;
}

#navButton:checked:hover {
    background-color: #E2F4ED;
}

#langCombo {
    margin: 8px 14px 4px 14px;
}

#adminButton {
    background-color: #FFF7E8;
    color: #C77700;
    border: 1px solid #F2DFBC;
    border-radius: 8px;
    padding: 9px 12px;
    margin: 8px 14px 14px 14px;
    font-size: 12px;
}

#adminButton:hover {
    background-color: #FDF0D8;
    border-color: #E0BE7E;
}

/* ---------- 仪表盘 ---------- */
#dashboardTitle {
    background: transparent;
    color: #1C2024;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 3px;
}

#dashboardSubtitle {
    background: transparent;
    color: #8A93A2;
    font-size: 13px;
}

#diskInfo {
    background: transparent;
    color: #5B6472;
    font-size: 13px;
}

#scanButton {
    background-color: #12A87B;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 22px;
    padding: 12px 44px;
}

#scanButton:hover {
    background-color: #14B98A;
}

#scanButton:pressed {
    background-color: #0E8F68;
}

/* ---------- 面板标题 ---------- */
#panelTitle {
    background: transparent;
    color: #1C2024;
    font-size: 17px;
    font-weight: 600;
    padding: 2px 0 6px 0;
}

/* 只设 color 的 QLabel 会被 Qt 填入默认底色，务必显式透明 */
#sectionHeader {
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 18px 0 6px 0;
}

/* ---------- 树/列表通用 ---------- */
QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FBFCFD;
    color: #1C2024;
    border: 1px solid #E4E7EC;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
    show-decoration-selected: 1;
}

QTreeWidget::item {
    padding: 7px 4px;
    border: none;
}

QTreeWidget::item:hover {
    background-color: #F1F3F6;
}

QTreeWidget::item:selected {
    background-color: #EAF7F2;
    color: #1C2024;
}

QHeaderView::section {
    background-color: #FBFCFD;
    color: #8A93A2;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.4px;
    padding: 9px 6px;
    border: none;
    border-bottom: 1px solid #E4E7EC;
}

QHeaderView::section:hover {
    color: #5B6472;
}

QTreeWidget QCheckBox {
    color: #1C2024;
    background: transparent;
}

/* ---------- 复选框 ---------- */
QCheckBox {
    background: transparent;
    color: #5B6472;
    font-size: 13px;
    spacing: 8px;
}

QCheckBox:hover {
    color: #1C2024;
}

QCheckBox::indicator,
QTreeWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #C9CFD8;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover,
QTreeWidget::indicator:hover {
    border-color: #12A87B;
}

QCheckBox::indicator:checked,
QTreeWidget::indicator:checked {
    background-color: #12A87B;
    border-color: #12A87B;
}

QCheckBox::indicator:indeterminate,
QTreeWidget::indicator:indeterminate {
    background-color: #F0B429;
    border-color: #F0B429;
}

QCheckBox::indicator:disabled,
QTreeWidget::indicator:disabled {
    border-color: #E4E7EC;
    background-color: #F1F3F6;
}

/* ---------- 下拉框 ---------- */
QComboBox {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #DDE2E9;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #C9CFD8;
    background-color: #FBFCFD;
}

QComboBox:focus {
    border-color: #12A87B;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8A93A2;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #DDE2E9;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #EAF7F2;
    selection-color: #0E8A65;
}

/* ---------- 普通按钮 ---------- */
#openLocationButton,
#customDirButton {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #DDE2E9;
    border-radius: 7px;
    padding: 7px 14px;
    font-size: 12px;
}

#openLocationButton:hover,
#customDirButton:hover {
    background-color: #F1F3F6;
    border-color: #C9CFD8;
}

#openLocationButton:disabled {
    background-color: #F7F8FA;
    color: #B4BBC6;
    border-color: #EDEFF3;
}

#expandButton {
    background-color: #FFFFFF;
    color: #5B6472;
    border: 1px solid #DDE2E9;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12px;
}

#expandButton:hover {
    background-color: #EAF7F2;
    color: #0E8A65;
    border-color: #B7E4D4;
}

#deleteButton {
    background-color: #FFFFFF;
    color: #D6453B;
    border: 1px solid #F0C9C5;
    border-radius: 7px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

#deleteButton:hover {
    background-color: #FDECEA;
    border-color: #D6453B;
    color: #C0392F;
}

#cleanButton {
    background-color: #12A87B;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 26px;
    font-size: 13px;
    font-weight: 600;
}

#cleanButton:hover {
    background-color: #14B98A;
}

#cleanButton:disabled {
    background-color: #EDEFF3;
    color: #B4BBC6;
}

/* ---------- 清理建议卡片 ---------- */
#advisorCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EC;
    border-radius: 12px;
    padding: 4px;
}

#advisorCard:hover {
    background-color: #FDFEFE;
    border-color: #D3D9E0;
}

#advisorName {
    background: transparent;
    color: #1C2024;
    font-size: 14px;
    font-weight: 600;
}

#advisorHint {
    background: transparent;
    color: #8A93A2;
    font-size: 12px;
}

#advisorSize {
    background: transparent;
    color: #0E8A65;
    font-size: 15px;
    font-weight: 600;
    min-width: 84px;
}

#advisorCount {
    background: transparent;
    color: #8A93A2;
    font-size: 12px;
    min-width: 56px;
}

#advisorCard QTreeWidget {
    background-color: #FBFCFD;
    border: 1px solid #EDEFF3;
    border-radius: 8px;
}

#advisorCard QHeaderView::section {
    background-color: #FBFCFD;
    color: #8A93A2;
    font-size: 11px;
    padding: 6px 8px;
}

/* ---------- 进度条 ---------- */
#scanProgress {
    background-color: #EDEFF3;
    border: none;
    border-radius: 3px;
    height: 6px;
}

#scanProgress::chunk {
    background-color: #12A87B;
    border-radius: 3px;
}

/* ---------- 状态栏 ---------- */
#statusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E4E7EC;
    color: #8A93A2;
    font-size: 12px;
}

#statusBar::item {
    border: none;
}

#statusLabel {
    background: transparent;
    color: #8A93A2;
    padding: 4px 16px;
}

#sizeLabel {
    background: transparent;
    color: #5B6472;
    font-size: 12px;
}

/* ---------- 分隔条 ---------- */
QSplitter::handle {
    background-color: #E4E7EC;
    width: 1px;
}

QSplitter::handle:hover {
    background-color: #12A87B;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #D3D9E0;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B4BBC6;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 2px 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #D3D9E0;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B4BBC6;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: none;
    border: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- 弹窗 ---------- */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    background: transparent;
    color: #1C2024;
    font-size: 13px;
}

QMessageBox QCheckBox {
    background: transparent;
    color: #5B6472;
}

QMessageBox QPushButton,
QDialogButtonBox QPushButton {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #DDE2E9;
    border-radius: 7px;
    padding: 8px 20px;
    min-width: 78px;
    font-size: 13px;
}

QMessageBox QPushButton:hover,
QDialogButtonBox QPushButton:hover {
    background-color: #F1F3F6;
    border-color: #C9CFD8;
}

QMessageBox QPushButton:default,
QDialogButtonBox QPushButton:default {
    background-color: #12A87B;
    color: #FFFFFF;
    border-color: #12A87B;
    font-weight: 600;
}

QMessageBox QPushButton:default:hover,
QDialogButtonBox QPushButton:default:hover {
    background-color: #14B98A;
}

QDialog {
    background-color: #FFFFFF;
}

#dialogTitle {
    background: transparent;
    color: #1C2024;
    font-size: 15px;
    font-weight: 600;
    padding: 4px 0 8px 0;
}

/* ---------- 磁盘选择列表 ---------- */
#driveList {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #E4E7EC;
    border-radius: 10px;
    font-size: 13px;
    outline: none;
    padding: 4px;
    min-height: 220px;
}

#driveList::item {
    padding: 9px 10px;
    border: none;
    border-radius: 7px;
}

#driveList::item:hover {
    background-color: #F1F3F6;
}

#driveList::item:selected {
    background-color: #EAF7F2;
    color: #0E8A65;
}

/* ---------- 菜单 ---------- */
QMenu {
    background-color: #FFFFFF;
    color: #1C2024;
    border: 1px solid #DDE2E9;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #EAF7F2;
    color: #0E8A65;
}

QMenu::separator {
    height: 1px;
    background-color: #EDEFF3;
    margin: 4px 8px;
}
